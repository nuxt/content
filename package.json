{
  "name": "@nuxt/content",
  "version": "4.0.0",
  "description": "Write your content inside your Nuxt app",
  "homepage": "https://content.nuxt.com",
  "keywords": [
    "nuxt",
    "content",
    "nuxt-module",
    "cms",
    "markdown",
    "mdc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt/content.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./v3": "./dist/runtime/v3/index.js",
    "./cms": "./dist/runtime/server/cms.js",
    "./utils": "./dist/runtime/utils/index.js",
    "./server": "./dist/runtime/v3/composables.server.js"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@comark/cms": "https://pkg.pr.new/comarkdown/comark-cms/@comark/cms@5261851",
    "@comark/vue": "^0.5.0",
    "@nuxt/kit": "^4.4.8",
    "defu": "^6.1.7",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.8",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.7.0",
    "nuxt": "^4.4.8",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
