{
  "name": "@nuxt/content4",
  "version": "4.0.0",
  "description": "Write your content inside your Nuxt app",
  "homepage": "https://content.nuxt.com",
  "keywords": [
    "nuxt",
    "content",
    "nuxt-module",
    "markdown",
    "mdc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt/content.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./v3": "./dist/runtime/v3/index.js",
    "./content": "./dist/runtime/server/content.js",
    "./utils": "./dist/runtime/utils/index.js",
    "./server": "./dist/runtime/v3/composables.server.js"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "typecheck": "npm run dev:prepare && nuxt prepare examples/v3-multi-source && nuxt prepare examples/v3-layers && vue-tsc --noEmit && vue-tsc --noEmit -p playground && vue-tsc --noEmit -p examples/v3-multi-source && vue-tsc --noEmit -p examples/v3-layers",
    "verify": "npm run dev:prepare && npm run prepack && npm run lint && npm run test && npm run typecheck"
  },
  "dependencies": {

    "comark-content": "^0.5.1",
    "@comark/vue": "^0.9.0",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@nuxt/kit": "^4.6.3",
    "comark": "^0.9.0",
    "defu": "^6.1.7",
    "forges": "^0.3.2",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^4.0.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.3",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxt/ui": "^4.12.0",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.13.0",
    "nuxt": "^4.6.3",
    "playwright-core": "^1.64.1",
    "shiki": "^4.5.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "shiki": "^4.3.1"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.18.0"
}
